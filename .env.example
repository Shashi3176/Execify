# ================================
# Execify — Environment Variables
# ================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ──────────────────────────────────
# Database
# ──────────────────────────────────

# MongoDB connection string
# Local: mongodb://localhost:27017/execify
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/execify
MONGODB_URI=mongodb://localhost:27017/execify

# ──────────────────────────────────
# Worker Pool Configuration
# ──────────────────────────────────

# Maximum number of jobs to execute concurrently
# Recommended: number of CPU cores - 1
# Range: 1-10
MAX_CONCURRENT_WORKERS=3

# Maximum time a single job is allowed to run (milliseconds)
# Jobs exceeding this will receive SIGTERM then SIGKILL
# Default: 10000 (10 seconds)
EXECUTION_TIME_LIMIT_MS=10000

# Maximum memory a job can use in bytes
# Default: 52428800 (50MB)
MAX_MEMORY_BYTES=52428800

# ──────────────────────────────────
# Application
# ──────────────────────────────────

# The URL where this app is running
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development
